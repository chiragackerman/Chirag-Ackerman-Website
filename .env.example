# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional. When provided, automatically persists all products, categories, stores,
# and clicks to your MongoDB Atlas or local database. If omitted, uses in-memory resilient storage.
MONGODB_URI=mongodb+srv://chiragackerman1112_db_user:gnfon3cG2lsXa77S@passman.cxj650s.mongodb.net/?appName=PassMan

# ADMIN_PASSWORD: Password used for admin dashboard access
ADMIN_PASSWORD=@Chirag1112

# CLOUDINARY CONFIGURATION: Optional.
# When provided, product images uploaded from the Admin Dashboard will automatically
# be hosted on your Cloudinary CDN. If omitted, images are securely hosted via
# the server's external media storage route (/uploads/*).
