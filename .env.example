# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# MONGODB_URI: Required for admin authentication. It also persists products, categories, stores,
# and clicks to your MongoDB Atlas or local database. Public pages can use memory storage without it.
# MONGODB_URI is required for admin authentication.
MONGODB_URI="mongodb://127.0.0.1:27017/chirag_ackerman"

# Server-side admin bootstrap configuration. Use a unique password of at least 12 characters.
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Site Administrator"
ADMIN_PASSWORD="replace-with-a-long-random-password"
SESSION_SECRET="replace-with-a-long-random-secret"

# CLOUDINARY CONFIGURATION: Optional.
# When provided, product images uploaded from the Admin Dashboard will automatically
# be hosted on your Cloudinary CDN. If omitted, images are securely hosted via
# the server's external media storage route (/uploads/*).
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Alternative single connection URI:
# CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"


