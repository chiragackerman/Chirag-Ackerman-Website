# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional. When provided, automatically persists all products, categories, stores,
# and clicks to your MongoDB Atlas or local database. If omitted, uses in-memory resilient storage.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/chirag_hq?retryWrites=true&w=majority"

# ADMIN_PASSWORD: Password used for admin dashboard access
ADMIN_PASSWORD="Ackerman@2026"

# CLOUDINARY CONFIGURATION: Optional.
# When provided, product images uploaded from the Admin Dashboard will automatically
# be hosted on your Cloudinary CDN. If omitted, images are securely hosted via
# the server's external media storage route (/uploads/*).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Alternative single connection URI:
# CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"


